# In config.env kopieren und die ESXi-Zugangsdaten eintragen.
# config.env enthält ein gültiges Passwort und darf nicht eingecheckt oder
# weitergegeben werden.

ESXI_HOST=192.0.2.10
ESXI_PORT=443
ESXI_USER=backup-api-user
ESXI_PASSWORD=CHANGE_ME

# Zertifikatsprüfung aktiviert lassen. Das ESXi-/CA-Zertifikat im lokalen
# Trust Store installieren. false nur vorübergehend in einem isolierten
# Testnetz verwenden.
ESXI_SSL_VERIFY=true

# Dedizierte Sicherheitssperre für backup_vm.py. Der eingegebene Wert von
# --confirm-vm muss exakt mit diesem Namen übereinstimmen.
TARGET_VM_NAME=ExampleVM

# Optionale, kommaseparierte Hostnamen, die ESXi in HttpNfcLease-URLs
# zurückgeben kann. ESXI_HOST ist immer erlaubt. Keine nicht vertrauenswürdigen
# Hosts ergänzen.
# ESXI_NFC_ALLOWED_HOSTS=esxi.example.invalid

# Optionale zusätzliche Identitätssperre. Nach dem ersten Inventarlauf empfohlen.
# EXPECTED_INSTANCE_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Geometrieprüfung für die dedizierte Ziel-VM. Werte der gewünschten VM eintragen.
EXPECTED_CPU=2
EXPECTED_RAM_MB=4096
EXPECTED_DISK_COUNT=1
EXPECTED_DISK_SIZE_GB=25

# Backups werden auf diesem Server gespeichert. Standard: ./backups.
BACKUP_OUTPUT_DIR=./backups

# Ausreichend Reserve für OVF-Metadaten und temporäre Dateien lassen.
MIN_FREE_GB=30

# Warte- und Lesezeitlimits für HttpNfcLease.
LEASE_TIMEOUT_SECONDS=300
READ_TIMEOUT_SECONDS=300

# Große Datastore-HTTP-Downloads verwenden eine Erkennung für ausbleibenden
# Byte-Fortschritt. Die Gesamtlaufzeit darf länger sein; das Zeitlimit beginnt
# erst, wenn keine Daten mehr eintreffen.
DOWNLOAD_STALL_TIMEOUT_SECONDS=3600

# Zeitlimit für Snapshot-Erstellung/-Entfernung und kleinere ESXi-Aufgaben.
TASK_TIMEOUT_SECONDS=3600

# Zeitlimit für den Fortschritt beim Datastore-seitigen VMDK-Kopier-Fallback.
# Die Gesamtlaufzeit darf länger sein; das Zeitlimit greift erst, wenn sich der
# Prozentwert nicht mehr ändert.
DATASTORE_COPY_STALL_TIMEOUT_SECONDS=3600

# Live-Backups sind standardmäßig crash-konsistent. Nur auf true setzen, wenn
# VMware-Tools-quiesced-Snapshots für diese VM nachweislich zuverlässig arbeiten.
LIVE_SNAPSHOT_QUIESCE=false
