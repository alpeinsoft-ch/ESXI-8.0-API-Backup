# Copy to config.env and fill in the ESXi credentials.
# Do not commit or share config.env. It contains a live password.

ESXI_HOST=192.0.2.10
ESXI_PORT=443
ESXI_USER=backup-api-user
ESXI_PASSWORD=CHANGE_ME

# Keep certificate verification enabled. Install the ESXi/CA certificate in the
# local trust store. Use false only temporarily on an isolated test network.
ESXI_SSL_VERIFY=true

# Dedicated safety gate for backup_vm.py. The typed --confirm-vm value must
# exactly match this name.
TARGET_VM_NAME=ExampleVM

# Optional comma-separated aliases that ESXi may return in HttpNfcLease URLs.
# The configured ESXI_HOST is always allowed. Never add untrusted hosts.
# ESXI_NFC_ALLOWED_HOSTS=esxi.example.invalid

# Optional extra identity lock. Recommended after the first inventory run.
# EXPECTED_INSTANCE_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Dedicated target-VM geometry lock. Match these values to the intended VM.
EXPECTED_CPU=2
EXPECTED_RAM_MB=4096
EXPECTED_DISK_COUNT=1
EXPECTED_DISK_SIZE_GB=25

# Backups are written on this server. Default is ./backups.
BACKUP_OUTPUT_DIR=./backups

# Keep sufficient overhead for OVF metadata and temporary files.
MIN_FREE_GB=30

# HttpNfcLease wait and read timeouts.
LEASE_TIMEOUT_SECONDS=300
READ_TIMEOUT_SECONDS=300

# Large Datastore HTTP downloads use byte-progress stall detection.
# Total runtime may be longer; timeout only starts after bytes stop arriving.
DOWNLOAD_STALL_TIMEOUT_SECONDS=3600

# Task timeout for snapshot creation/removal and smaller ESXi tasks.
TASK_TIMEOUT_SECONDS=3600

# Datastore-side VMDK copy progress timeout for powered-on fallback exports.
# Total runtime may be longer; timeout only starts after the percent value stops changing.
DATASTORE_COPY_STALL_TIMEOUT_SECONDS=3600

# Live backups are crash-consistent by default. Set true only if VMware Tools
# quiesced snapshots are known to work reliably for this VM.
LIVE_SNAPSHOT_QUIESCE=false
